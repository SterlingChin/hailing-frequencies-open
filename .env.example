# Fill these locally; do not commit your .env file.
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional local CRM / voice configuration. Never print these values.
DATABASE_URL=
DEMO_CALLER_E164=
TWILIO_VOICE_PUBLIC_DOMAIN=
# Integration tests accept loopback Postgres only; never use production here.
TEST_DATABASE_URL=

# App defaults: local loopback; Railway supplies PORT and uses 0.0.0.0.
# HOST=127.0.0.1
# PORT=8788
VOICE_ENABLED=false
SMS_ENABLED=false
# Decisions API routing step (POST /v1/decisions, gpt-6-luna). Needs OPENAI_API_KEY when true.
DECISIONS_ENABLED=false
REPORTING_API_TOKEN=
# Outbound reply calls through the same bridge. Needs VOICE_ENABLED=true, DATABASE_URL and an E.164 caller ID.
CALLBACK_ENABLED=false
# Server-to-server bearer token for the demo caller-context API. Generate at least 32 random characters; share privately with Michael.
# CONTEXT_API_TOKEN=
TWILIO_VOICE_FROM=
TWILIO_SMS_FROM=
VOICE_CALL_LIMIT=1
VOICE_MAX_SESSION_SECONDS=120
