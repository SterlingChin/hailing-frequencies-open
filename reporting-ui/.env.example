# All values are server-side. Never prefix a key with VITE_.
HOST=127.0.0.1
PORT=5173

# Local operator console at /rehearsal.html?mode=real. Run on loopback only.
# These are server-side and never sent to the browser.
REHEARSAL_ENABLED=false
HF_BACKEND_URL=<your deployment URL>
REPORTING_API_TOKEN=

# Enabling Live permits paid requests
# only when a person selects GPT-Live and taps Engage.
LIVE_ENABLED=false
OPENAI_API_KEY=
LIVE_BACKEND_MODEL=gpt-6-luna

# Server-to-server profile service. Set the shared token privately.
CONTEXT_API_BASE_URL=<your deployment URL>
CONTEXT_API_TOKEN=

# Set the exact browser origin when using an HTTPS reverse proxy.
# Example: https://your-private-preview.example
PUBLIC_ORIGIN=

# Optional direct HTTPS, using a certificate trusted by your iPhone.
TLS_KEY_FILE=
TLS_CERT_FILE=

# MCP expert routing. Token is server-side only.
EXPERT_MCP_URL=<your Expert Agent MCP deployment URL>/mcp
SPECIALISTS_MCP_TOKEN=

# Durable MCP claims/receipts. Use a persistent volume in production.
EXPERT_DISPATCH_DIR=
