# Copy to .env (git-ignored). Every value is optional except OPENAI_API_KEY for live runs.

# OpenAI — read by the Agents SDK. Never commit a real key.
OPENAI_API_KEY=

# Model used by both the triage and the investigation agents.
EXPERT_MODEL=gpt-5.6-sol

# Streamable HTTP listener. Loopback only unless EXPERT_MCP_ALLOW_NONLOOPBACK=true.
EXPERT_MCP_HOST=127.0.0.1
EXPERT_MCP_PORT=8010
EXPERT_MCP_ALLOW_NONLOOPBACK=false
# If set, every request must carry "Authorization: Bearer <token>".
EXPERT_MCP_TOKEN=

# Sandbox: docker (default) or scripted (no Docker; used by tests).
EXPERT_SANDBOX=local
EXPERT_DOCKER_IMAGE=python:3.14-slim
# none (default: no network inside the container) or default (Docker's default bridge network).
EXPERT_SANDBOX_NETWORK=none

# MCP task lifetime / suggested poll interval, and dispatched-job retention.
EXPERT_TASK_TTL_MS=3600000
EXPERT_POLL_INTERVAL_MS=2000
EXPERT_DISPATCH_TTL_MS=3600000
EXPERT_MAX_CONCURRENT=3

# Path of the env file to load, relative to mcp/. An empty string disables loading.
# EXPERT_ENV_FILE=.env
