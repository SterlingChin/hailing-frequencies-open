              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route or report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Channel/report state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Live budget or concurrency reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Action failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Live setup failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Live disabled or demo capacity reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "channelId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoCookie": [],
            "DemoCsrf": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ]
      }
    },
    "/api/report": {
      "post": {
        "operationId": "editReportingReport",
        "summary": "Review a captured demo report",
        "description": "Requires existing report and demo identity; issue and location are trimmed and capped. Stored only in this browser demo session; delivery remains not_sent. Requires hf_demo cookie, X-CSRF-Token and exact configured same Origin. JSON body limit 128 KiB; no CRM or Twilio delivery implied.",
        "responses": {
          "200": {
            "description": "Updated session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicState"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or arguments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route or report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Channel/report state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Live budget or concurrency reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Action failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Live setup failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Live disabled or demo capacity reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "issue": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6000
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "issue"
                ]
              }
            }
          }
        },
        "security": [
          {
            "DemoCookie": [],
            "DemoCsrf": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ]
      }
    },
    "/api/report/select": {
      "post": {
        "operationId": "selectReportingReport",
        "summary": "Select a stored demo report",
        "description": "Selects only a report belonging to the current in-memory demo session. Requires hf_demo cookie, X-CSRF-Token and exact configured same Origin. JSON body limit 128 KiB; no CRM or Twilio delivery implied.",
        "responses": {
          "200": {
            "description": "Updated session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicState"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or arguments",
