{
  "openapi": "3.0.3",
  "info": {
    "title": "Reporting UI API",
    "version": "0.2.0",
    "description": "Source inventory of Michael’s reporting UI service; only recorded observations establish deployed behavior. This service retains its own demo identity and report state; it is not the caller-context CRM API."
  },
  "servers": [
    {
      "url": "https://hailing-frequencies-reporting-production.up.railway.app"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "reportingHealth",
        "summary": "Report reporting-UI process readiness and enabled integrations; makes no provider requests.",
        "responses": {
          "200": {
            "description": "Reporting UI process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service",
                    "liveEnabled",
                    "externalDeliveryEnabled"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    },
                    "service": {
                      "type": "string",
                      "enum": [
                        "reporting-ui"
                      ]
                    },
                    "liveEnabled": {
                      "type": "boolean"
                    },
                    "externalDeliveryEnabled": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "operationId": "getReportingSession",
        "summary": "Create or read a browser demo session",
        "description": "May set HttpOnly SameSite=Strict hf_demo cookie and returns csrf. In-memory session expires after inactivity/restart. Makes no provider call.",
        "responses": {
          "200": {
            "description": "Current session including CSRF token",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PublicState"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "csrf": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "csrf"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Live disabled or demo capacity reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/events": {
      "get": {
        "operationId": "streamReportingSession",
        "summary": "Stream browser session state",
        "description": "Cookie required; max three listeners per session. SSE data contains public session state and report updates, not a CRM delivery event stream.",
        "responses": {
          "200": {
            "description": "Session SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Session expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many open screens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoCookie": []
          }
        ]
      }
    },
    "/api/begin": {
      "post": {
        "operationId": "beginReportingLive",
        "summary": "Start a GPT-Live channel",
        "description": "Consumes live call budget and may make billable OpenAI requests when LIVE_ENABLED permits. Only live mode is accepted. Returns SDP answer. Requires separate live authorization. Requires hf_demo cookie, X-CSRF-Token and exact configured same Origin. JSON body limit 128 KiB; no CRM or Twilio delivery implied.",
        "responses": {
          "200": {
            "description": "Updated session state",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PublicState"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "sdp": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sdp"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or arguments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route or report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Channel/report state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Live budget or concurrency reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Action failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Live setup failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Live disabled or demo capacity reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "live"
                    ]
                  },
                  "channelId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9-]{8,64}$"
                  },
                  "sdp": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  }
                },
                "required": [
                  "mode",
                  "sdp"
                ]
              }
            }
          }
        },
        "security": [
          {
            "DemoCookie": [],
            "DemoCsrf": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ]
      }
    },
    "/api/stop": {
      "post": {
        "operationId": "stopReportingLive",
        "summary": "Stop or cancel a channel",
        "description": "Stops the current Live session; a mismatched channel ID is marked cancelled without stopping another channel. May signal an active provider session. Requires hf_demo cookie, X-CSRF-Token and exact configured same Origin. JSON body limit 128 KiB; no CRM or Twilio delivery implied.",
        "responses": {
          "200": {
            "description": "Updated session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicState"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or arguments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route or report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Channel/report state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Live budget or concurrency reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Action failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Live setup failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Live disabled or demo capacity reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "channelId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "DemoCookie": [],
            "DemoCsrf": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ]
      }
    },
    "/api/live/ready": {
      "post": {
        "operationId": "readyReportingLive",
        "summary": "Signal that the client media connection is ready",
        "description": "Requires an active Live session; may trigger the live greeting. Unknown/inactive session returns 404. Requires hf_demo cookie, X-CSRF-Token and exact configured same Origin. JSON body limit 128 KiB; no CRM or Twilio delivery implied.",
        "responses": {
          "200": {
            "description": "Updated session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicState"
                }
              }
            }
          },
          "400": {
