                }
              }
            }
          },
          "429": {
            "description": "Live budget or concurrency reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Action failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Live setup failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Live disabled or demo capacity reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        "security": [
          {
            "DemoCookie": [],
            "DemoCsrf": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DemoCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hf_demo"
      },
      "DemoCsrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "PublicState": {
        "type": "object",
        "properties": {
          "crew": {
            "type": "object",
            "properties": {}
          },
          "phrase": {
            "type": "string",
            "description": "Existing UI demo fixture phrase, independent of CRM authorization."
          },
          "authorized": {
            "type": "boolean"
          },
          "attempts": {
            "type": "integer"
          },
          "mode": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "liveStatus": {
            "type": "string"
          },
          "channelId": {
            "type": "string"
          },
          "report": {
            "type": "object",
            "properties": {},
            "nullable": true
          },
          "hasCurrentReport": {
            "type": "boolean"
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {}
            }
          },
          "liveConfigured": {
            "type": "boolean"
          },
          "liveRemaining": {
            "type": "integer"
          }
        }
      }
    }
  }
}
